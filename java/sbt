set -euo pipefail
cd "$(dirname "$0")"
launcher_dir="${SBT_LAUNCH_DIR:-.sbt-launch}"
launcher="$launcher_dir/sbt-launch-1.12.15.jar"
mkdir -p "$launcher_dir"
if [[ ! -f "$launcher" ]]; then
  curl --fail --location --silent --show-error \
    https://repo.maven.apache.org/maven2/org/scala-sbt/sbt-launch/1.12.15/sbt-launch-1.12.15.jar \
    --output "$launcher.tmp"
  mv "$launcher.tmp" "$launcher"
fi
expected=9f3594272dc3209a9f03b14715783c361bab7d95bae8d75637ab40fe22005264
actual=$(shasum -a 256 "$launcher")
if [[ "${actual%% *}" != "$expected" ]]; then
  echo "sbt launcher checksum mismatch: $launcher" >&2
  exit 1
fi
exec java -jar "$launcher" "$@"
